# Copy to .env for `make run` (the app reads .env from the working directory;
# real environment variables take precedence). Values below are placeholders.

# --- Application ---
APP_NAME=golang-boilerplate
APP_PORT=8080
# development | production (production: release-mode Gin, JSON logs, HSTS,
# and the example JWT secret is refused)
APP_MODE=development
APP_VERSION=dev
# Comma-separated origins allowed to call the API from a browser, e.g.
# https://app.example.com. Empty = same-origin only. "*" = any origin.
CORS_ALLOWED_ORIGINS=
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is
# trusted. Empty = use the TCP peer address.
TRUSTED_PROXIES=

# --- Database (PostgreSQL; docker compose publishes it on 15432) ---
DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=golang_boilerplate
DB_SSL_MODE=disable
DB_TIMEZONE=UTC

# --- Auth ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Access token lifetime (Go duration: 15m, 1h, ...)
JWT_EXPIRATION=1h
JWT_ISSUER=golang-boilerplate
# bcrypt work factor (10-31)
BCRYPT_COST=12
# Requests per minute per client IP on /auth/register and /auth/login
AUTH_RATE_LIMIT_PER_MINUTE=10
